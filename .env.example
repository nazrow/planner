# For local runs. On the server, deploy/deploy.sh writes /etc/planner/planner.env
# with a generated password instead.

# Postgres
DATABASE_URL=postgresql+asyncpg://planner:planner@127.0.0.1:5432/planner

# Local dev without Postgres:
# DATABASE_URL=sqlite+aiosqlite:///./planner.db

# Days an auth token stays valid
TOKEN_TTL_DAYS=30

# Run pending migrations when the app starts (set 0 to run them by hand)
MIGRATE_ON_START=1

HOST=0.0.0.0
PORT=11111
